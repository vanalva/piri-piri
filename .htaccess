# somospiripiri.com — Apache/LiteSpeed config for Hostinger shared hosting.
# Copied verbatim to the web root by build-web.js (src/static/** passthrough).
# Reproduces the two behaviours Webflow was providing for us: the apex -> www
# canonical redirect, and a real 404 route.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Anything not on www -> www, preserving scheme upgrade in the same hop.
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteRule ^ https://www.somospiripiri.com%{REQUEST_URI} [R=301,L]

    # 2. www but still plain HTTP -> HTTPS. Both conditions must be false to
    #    skip, so an already-secure request never re-enters the rule and there
    #    is no loop. X-Forwarded-Proto covers the case where TLS terminates
    #    upstream and %{HTTPS} reads as off.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://www.somospiripiri.com%{REQUEST_URI} [R=301,L]
</IfModule>

# 404.html is built from src/pages/404.html and lives at the web root.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
    # Matches the header Webflow was already sending, so browsers that cached
    # HSTS from the old host keep an unbroken policy across the migration.
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # HTML must never be served stale: pushes to GitHub auto-deploy straight to
    # production, so an edit has to be visible on the next request. `no-cache`
    # means revalidate, not "don't store" — the browser still sends a
    # conditional request and gets a cheap 304 when nothing changed.
    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType video/mp4                 "access plus 1 year"
</IfModule>
